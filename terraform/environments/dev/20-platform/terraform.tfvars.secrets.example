# Copy to terraform.tfvars.secrets (gitignored).
# terraform apply -var-file=terraform.tfvars.secrets

# PAT auth (flux_token_auth = true) — fine-grained token, Contents: read/write on the fleet repo only.
# github_token = "github_pat_xxxxxxxx"

# SSH auth (flux_token_auth = false) — deploy key with write access.
# github_ssh_private_key_path       = "~/.ssh/fleet_deploy_key"
# github_ssh_private_key_passphrase = ""
