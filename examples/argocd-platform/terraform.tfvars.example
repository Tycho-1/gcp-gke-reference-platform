# Copy to terraform.tfvars (gitignored).

project_id   = "your-gcp-project-id"
region       = "europe-west4"
cluster_name = "platform-ref-gke-dev" # from 10-foundation output cluster_name

argocd_chart_version       = "9.4.11"
argocd_server_service_type = "ClusterIP" # port-forward; LoadBalancer = public UI (lab only)
argocd_admin_enabled       = true        # false once SSO/OIDC is configured

# Optional commit-to-deploy sample (see ../gitops-argocd-sample/)
# argocd_gitops_repo_url        = "https://github.com/YOU/YOUR_REPO.git"
# argocd_gitops_target_revision = "main"
# argocd_gitops_repo_path       = "apps/sample-app"
# Private repo (one of): TF_VAR_argocd_gitops_https_password or TF_VAR_argocd_gitops_ssh_private_key
